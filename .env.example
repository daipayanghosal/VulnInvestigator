# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Configuration ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434
LLM_BACKEND=gemini        # openai | ollama | gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ── NVD API ──────────────────────────────────────────────────────────────────
# Optional: without a key the NVD allows ~5 req/30s; with key ~50 req/30s
NVD_API_KEY=

# ── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
